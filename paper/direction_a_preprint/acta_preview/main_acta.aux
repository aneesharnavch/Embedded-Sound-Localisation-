\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Temporal averaging evaluated on new recordings. (a) Circular block averages for all 72 scenes, separated into the low-reverberation/centred and high-reverberation/offset subsets. (b) Results for the 49 scenes that met the criteria applied to the estimation recordings. Model curves are predictions, whereas shaded bands are bootstrap intervals obtained from complete test recordings. Estimation and test recordings are independent.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:averaging}{{5}{10}{Temporal averaging evaluated on new recordings. (a) Circular block averages for all 72 scenes, separated into the low-reverberation/centred and high-reverberation/offset subsets. (b) Results for the 49 scenes that met the criteria applied to the estimation recordings. Model curves are predictions, whereas shaded bands are bootstrap intervals obtained from complete test recordings. Estimation and test recordings are independent}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Timing precision and sensitivity conditions. (a) Analytical changes caused by arrival-time rounding and their bounds at 48 kHz, with an array radius of 0.05 m and a source distance of 1.5 m. Changes are measured relative to the estimates obtained from exact spherical arrivals. (b) RMSE and record-bootstrap intervals for five conditions on the fixed 24-scene subset. In the narrower-source-band condition, the acquisition and estimator bands remain 300--3400 Hz.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:precision}{{6}{10}{Timing precision and sensitivity conditions. (a) Analytical changes caused by arrival-time rounding and their bounds at 48 kHz, with an array radius of 0.05 m and a source distance of 1.5 m. Changes are measured relative to the estimates obtained from exact spherical arrivals. (b) RMSE and record-bootstrap intervals for five conditions on the fixed 24-scene subset. In the narrower-source-band condition, the acquisition and estimator bands remain 300--3400 Hz}{figure.6}{}}
